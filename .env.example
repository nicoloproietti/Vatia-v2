# Credenziali del NUOVO progetto Supabase dedicato a Vatia v2.
# Non riutilizzare il progetto o i dati di DietProject.
VITE_SUPABASE_URL=https://your-new-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-new-project-anon-key

# OAuth Client ID Web di Google Cloud per Google Calendar (non è un segreto).
# Autorizza l'origine locale e quella GitHub Pages. Per gli account autenticati,
# il code flow usa l'Edge Function google-calendar; il Client Secret, la chiave
# AES e CRON_SECRET vanno configurati soltanto nei segreti Supabase, mai qui.
VITE_GOOGLE_CLIENT_ID=
